#!/usr/bin/env bash
set -euo pipefail
args=(); skip=0
for arg in "$@"; do
  if ((skip)); then skip=0; continue; fi
  case "$arg" in --target|-target) skip=1;; --target=*|-target=*|-Wl,-melf_i386) ;; -Wp,-U_FORTIFY_SOURCE) args+=(-U_FORTIFY_SOURCE);; *) args+=("$arg");; esac
done
# Zig provides an empty libatomic for this target. Supply LLVM's standard
# query implementation when an actual link requests it. Compilation flags
# and the cached Rust/C libraries are unchanged.
needs_query=0
for arg in "${args[@]}"; do
  if [[ "$arg" = -latomic ]]; then needs_query=1; fi
  if [[ "$arg" = -c || "$arg" = -E || "$arg" = -S ]]; then needs_query=0; break; fi
done
if ((needs_query)); then
  tool_dir=$(cd "$(dirname "$0")" && pwd)
  query_object=$(mktemp "${TMPDIR:-/tmp}/codex-atomic-query.XXXXXX")
  trap 'rm -f "$query_object"' EXIT
  zig cc -target x86-linux-musl -mcpu=pentium4 -O2 -fno-sanitize=undefined \
    -c "$tool_dir/atomic-query.c" -o "$query_object"
  zig cc -target x86-linux-musl -mcpu=pentium4 "${args[@]}" "$query_object" -fno-sanitize=undefined
else
  exec zig cc -target x86-linux-musl -mcpu=pentium4 "${args[@]}" -fno-sanitize=undefined
fi
