#!/usr/bin/env bash
set -euo pipefail
args=(); skip=0
for arg in "$@"; do
  if ((skip)); then skip=0; continue; fi
  case "$arg" in --target|-target) skip=1;; --target=*|-target=*) ;; -Wp,-U_FORTIFY_SOURCE) args+=(-U_FORTIFY_SOURCE);; *) args+=("$arg");; esac
done
exec zig cc -target x86-linux-musl -mcpu=pentium "${args[@]}" -fno-sanitize=undefined
