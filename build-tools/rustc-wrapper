#!/bin/sh
set -eu
compiler=$1
shift
crate_name=
target=
previous=
for arg do
    case "$previous" in
        --crate-name) crate_name=$arg ;;
        --target) target=$arg ;;
    esac
    case "$arg" in
        --crate-name=*) crate_name=${arg#--crate-name=} ;;
        --target=*) target=${arg#--target=} ;;
    esac
    previous=$arg
done
# LLVM auto-vectorizes an integer bitset comparison into MOVMSKPS, which
# released iSH does not decode. Keep this crate's target features and ABI;
# compile only this crate's x86 build at optimization level zero.
if [ "$crate_name" = regex_automata ] && [ "$target" = i686-unknown-linux-musl ]; then
    exec "$compiler" "$@" -C opt-level=0
fi
exec "$compiler" "$@"
